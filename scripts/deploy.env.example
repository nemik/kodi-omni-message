# Copy to scripts/deploy.env (gitignored) and fill in for your test PC.
# This is sourced by bash, so quote any value containing spaces: PASS="two words".

# SSH target for the Linux desktop running Kodi.
KODI_HOST=192.168.1.50
KODI_SSH_USER=kodi

# Where Kodi looks for add-ons on that machine. A path without a leading / is
# resolved against the remote user's home. Do not use ~ here: this file is
# sourced locally, so a tilde would expand to *this* machine's home.
#   Linux desktop:      .kodi/addons
#   LibreELEC/CoreELEC: /storage/.kodi/addons
KODI_ADDON_DIR=.kodi/addons

# Kodi's JSON-RPC endpoint, used to restart the service after a deploy.
# Enable it under Settings > Services > Control > Allow remote control via HTTP.
KODI_RPC_PORT=8080
KODI_RPC_USER=kodi
KODI_RPC_PASS=kodi

# Optional. Run over ssh to restart Kodi when it doesn't yet know the add-on
# (Kodi only scans for new add-ons at startup). Leave unset to be told what to
# do instead of having Kodi restarted under you. Examples:
#   KODI_RESTART_CMD="sudo systemctl restart kodi"       # systemd service
#   KODI_RESTART_CMD="systemctl --user restart kodi"     # user service
# There is nothing to set here if Kodi is started by your desktop session.
#KODI_RESTART_CMD=
